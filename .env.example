# Settings reads the process environment; this file is documentation, not an implicit dotenv loader.
# For local work `npm run dev:api` (scripts/dev_api.py) fills in everything below that is not set.
APLOMB_ENV=local
AWS_REGION=us-east-1
# The pinned snapshot: data/manifests/active.json names the active version.
APLOMB_DATA_VERSION=snap-20261114-sourced
APLOMB_DATA_AS_OF=2026-11-12
# Data root holding manifests/, raw/ and normalized/ (materialize with the ingestion CLI, data/SPEC.md).
APLOMB_DATA_DIR=data
APLOMB_LOCAL_STATE_FILE=.artifacts/aplomb-local-state.json
APLOMB_ALLOWED_ORIGINS=http://localhost:3000
# Research tools need a contact (an https:// URL or an email) in the user agent; without one they
# are simply not registered. Never commit a personal address.
APLOMB_SOURCE_USER_AGENT=
# Set from stack outputs for AWS; never put credentials here.
APLOMB_DATA_BUCKET=
APLOMB_DATA_PREFIX=snapshots/snap-20261114-sourced/
APLOMB_PROFILES_TABLE=
APLOMB_RUNS_TABLE=
APLOMB_CACHE_TABLE=
APLOMB_WORKER_FUNCTION=
# Bedrock model IDs. Without both, runs and free-text parsing answer 503 (deterministic endpoints still work).
APLOMB_MODEL_STRONG=
APLOMB_MODEL_FAST=
APLOMB_GUARDRAIL_ID=
APLOMB_GUARDRAIL_VERSION=
APLOMB_RUN_TARGET_SECONDS=90
APLOMB_RUN_HARD_SECONDS=180
APLOMB_MAX_REVISE=2
APLOMB_MAX_LLM_CALLS=12
APLOMB_MAX_RESEARCH_CALLS=12
APLOMB_LEASE_SECONDS=30
# On-demand tickers (local data dir only): owner's Tiingo token; leave empty to keep the feature off.
APLOMB_TIINGO_TOKEN=
APLOMB_MAX_BODY_BYTES=262144
# A flag is advertised in /meta only when it is true here AND its provider exists.
# Providers exist for these seven:
APLOMB_FEATURE_BILINGUAL=true
APLOMB_FEATURE_WORLD_EXPLORER=true
APLOMB_FEATURE_WORLD_LAYER_HAZARDS=true
APLOMB_FEATURE_TIME_MACHINE=true
APLOMB_FEATURE_PROFILE_CREATOR=true
APLOMB_FEATURE_GOAL_REQUESTS=true
APLOMB_FEATURE_FRONTIER_CHART=true
# No provider yet: setting these to true changes nothing.
APLOMB_FEATURE_WORLD_LAYER_FACILITIES=false
APLOMB_FEATURE_SABOTAGE_DEMO=false
APLOMB_FEATURE_RESEARCH_OPEN_WEB=false
APLOMB_FEATURE_GUARDRAILS=false
APLOMB_FEATURE_ON_DEMAND_TICKERS=false

# Optional local research accounts. Never commit credential values.
APLOMB_ALPHA_VANTAGE_KEY=
APLOMB_ALPHA_VANTAGE_RIGHTS_CONFIRMED=false
APLOMB_FINNHUB_KEY=
APLOMB_FINNHUB_RIGHTS_CONFIRMED=false
APLOMB_TWELVEDATA_KEY=
APLOMB_TWELVEDATA_RIGHTS_CONFIRMED=false
APLOMB_OPENDART_KEY=
APLOMB_OPENDART_RIGHTS_CONFIRMED=false
# Japan is separate from Korea; configure only after obtaining an account.
APLOMB_JQUANTS_KEY=
APLOMB_JQUANTS_RIGHTS_CONFIRMED=false

# Additional owner-selected data accounts. Keep actual values in ignored .env.
APLOMB_FMP_KEY=
APLOMB_FMP_RIGHTS_CONFIRMED=false
APLOMB_EODHD_KEY=
APLOMB_EODHD_RIGHTS_CONFIRMED=false
APLOMB_MASSIVE_KEY=
APLOMB_MASSIVE_RIGHTS_CONFIRMED=false
APLOMB_MARKETSTACK_KEY=
APLOMB_MARKETSTACK_RIGHTS_CONFIRMED=false
APLOMB_COINMARKETCAP_KEY=
APLOMB_COINMARKETCAP_RIGHTS_CONFIRMED=false
APLOMB_BLOCKSCOUT_KEY=
APLOMB_BLOCKSCOUT_RIGHTS_CONFIRMED=false
APLOMB_ALCHEMY_KEY=
APLOMB_ALCHEMY_RIGHTS_CONFIRMED=false
APLOMB_GOLDRUSH_KEY=
APLOMB_GOLDRUSH_RIGHTS_CONFIRMED=false
APLOMB_FRED_KEY=
# Enable only with documented permission compatible with AI use and retained captures.
APLOMB_ALFRED_RIGHTS_CONFIRMED=false
