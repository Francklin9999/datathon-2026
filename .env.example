# Settings reads the process environment; this file is documentation, not an implicit dotenv loader.
# For local work `npm run dev:api` (scripts/dev_api.py) fills in everything below that is not set.
APLOMB_ENV=local
AWS_REGION=us-east-1
# The pinned snapshot. Left unset, dev:api serves the version named by data/manifests/active.json and
# takes the data date from that version's manifest; set a label only to serve another committed version.
# APLOMB_DATA_VERSION=
# APLOMB_DATA_AS_OF=
# Data root holding manifests/, raw/ and normalized/ (materialize with the ingestion CLI, data/SPEC.md).
APLOMB_DATA_DIR=data
APLOMB_LOCAL_STATE_FILE=.artifacts/aplomb-local-state.json
APLOMB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Research tools need a contact (an https:// URL or an email) in the user agent; without one they
# are simply not registered. Never commit a personal address.
APLOMB_SOURCE_USER_AGENT=
# Set from stack outputs for AWS; never put credentials here.
APLOMB_DATA_BUCKET=
# S3 prefix under APLOMB_DATA_BUCKET; infra uses snapshots/<APLOMB_DATA_VERSION>/.
APLOMB_DATA_PREFIX=
APLOMB_PROFILES_TABLE=
APLOMB_RUNS_TABLE=
APLOMB_CACHE_TABLE=
APLOMB_WORKER_FUNCTION=
# Bedrock model IDs. Without both, runs and free-text parsing answer 503 (deterministic endpoints still work).
APLOMB_MODEL_STRONG=
APLOMB_MODEL_FAST=
# Optional: a different Bedrock model tried once when a primary model call fails on the model side
# (throttling, timeout, model error); unset or invalid means no fallback. The AWS stack does not set it.
# APLOMB_BEDROCK_FALLBACK_MODEL_ID=
# Set by the stack from the release revision (40 lowercase hex characters), sent as X-Aplomb-Build;
# leave unset locally.
# APLOMB_BUILD_REVISION=
APLOMB_GUARDRAIL_ID=
APLOMB_GUARDRAIL_VERSION=
APLOMB_RUN_HARD_SECONDS=180
APLOMB_MAX_REVISE=2
APLOMB_MAX_LLM_CALLS=12
APLOMB_MAX_RESEARCH_CALLS=12
APLOMB_LEASE_SECONDS=30
# On-demand tickers (local data dir only): owner's Tiingo token; leave empty to keep the feature off.
APLOMB_TIINGO_TOKEN=
APLOMB_MAX_BODY_BYTES=262144
# A flag is advertised in /meta only when it is true here AND its provider is available
# (backend/aplomb/api/domain.py, default_services).
# Available with a configured snapshot alone (world flags: with the packaged world bundle):
APLOMB_FEATURE_BILINGUAL=true
APLOMB_FEATURE_WORLD_EXPLORER=true
APLOMB_FEATURE_WORLD_LAYER_HAZARDS=true
APLOMB_FEATURE_TIME_MACHINE=true
APLOMB_FEATURE_PROFILE_CREATOR=true
APLOMB_FEATURE_GOAL_REQUESTS=true
APLOMB_FEATURE_FRONTIER_CHART=true
# The flags below need a prerequisite. Without it the flag stays off in /meta, except guardrails,
# which makes the API refuse to start. The next three are true here as in dev:api (its FEATURES), so a
# .env copied from this file does not switch them off; /meta still waits for their prerequisite.
# Needs the packaged facility capture (backend/aplomb/world/bundle/facilities.json, integrity-checked).
APLOMB_FEATURE_WORLD_LAYER_FACILITIES=true
# Needs APLOMB_TIINGO_TOKEN and a writable local data dir (APLOMB_ENV=local, no APLOMB_DATA_BUCKET).
APLOMB_FEATURE_ON_DEMAND_TICKERS=true
# Needs both Bedrock model IDs (APLOMB_MODEL_STRONG and APLOMB_MODEL_FAST).
APLOMB_FEATURE_SABOTAGE_DEMO=true
# No provider: the AgentCore Browser tool (web.browse) was removed, so /meta reports it false whatever this value.
APLOMB_FEATURE_RESEARCH_OPEN_WEB=false
# Needs APLOMB_GUARDRAIL_ID and APLOMB_GUARDRAIL_VERSION (startup fails without them) and both model IDs.
APLOMB_FEATURE_GUARDRAILS=false

