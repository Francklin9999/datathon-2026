# Settings reads process environment; load .env explicitly if wanted.
APLOMB_ENV=local
AWS_REGION=us-east-1
APLOMB_DATA_VERSION=snap-20261113-starter
APLOMB_DATA_AS_OF=2026-11-12
APLOMB_DATA_DIR=Datathon2026/alphaforge_starter
APLOMB_LOCAL_STATE_FILE=/tmp/aplomb-local-state.json
APLOMB_ALLOWED_ORIGINS=http://localhost:3000
APLOMB_SOURCE_USER_AGENT=Aplomb research demo (configure operator contact)
# Set from stack outputs for AWS; never put credentials here.
APLOMB_DATA_BUCKET=
APLOMB_DATA_PREFIX=snapshots/snap-20261113-starter
APLOMB_PROFILES_TABLE=
APLOMB_RUNS_TABLE=
APLOMB_CACHE_TABLE=
APLOMB_WORKER_FUNCTION=
APLOMB_MODEL_STRONG=
APLOMB_MODEL_FAST=
APLOMB_GUARDRAIL_ID=
APLOMB_GUARDRAIL_VERSION=
APLOMB_RUN_TARGET_SECONDS=90
APLOMB_RUN_HARD_SECONDS=180
APLOMB_MAX_REVISE=2
APLOMB_MAX_LLM_CALLS=12
APLOMB_MAX_RESEARCH_CALLS=12
APLOMB_LEASE_SECONDS=30
APLOMB_MAX_BODY_BYTES=262144
# Flags need BOTH configuration and verified Services.capabilities entries.
APLOMB_FEATURE_BILINGUAL=false
APLOMB_FEATURE_WORLD_EXPLORER=false
APLOMB_FEATURE_WORLD_LAYER_FACILITIES=false
APLOMB_FEATURE_WORLD_LAYER_HAZARDS=false
APLOMB_FEATURE_TIME_MACHINE=false
APLOMB_FEATURE_PROFILE_CREATOR=false
APLOMB_FEATURE_GOAL_REQUESTS=false
APLOMB_FEATURE_SABOTAGE_DEMO=false
APLOMB_FEATURE_RESEARCH_OPEN_WEB=false
APLOMB_FEATURE_GUARDRAILS=false
APLOMB_FEATURE_ON_DEMAND_TICKERS=false
APLOMB_FEATURE_FRONTIER_CHART=false
