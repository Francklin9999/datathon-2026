.ted-search__options-mobile-dropdown-menu {
	background: #FFFFFF;
	box-shadow: 1px 3px 12px rgb(0 0 0 / 40%);
	border-radius: 3px;
	max-width: unset;
	padding: 24px 20px;
	overflow: unset;
}

.ted-search__options-mobile-dropdown-menu::after {
	content: unset;
}

.ted-search__options-mobile-button {
	font-size: 14px;
	line-height: 20px;
	border-radius: 3px;
	display: block;
	padding: 10px 20px;
	border: none;
	margin-bottom: 16px;
	white-space: nowrap;
}

.ted-search__options-mobile-button--color {
	font-weight: bold;
	background: #3D6ECF;
	color: #FFFFFF;
}

.ted-search__options-mobile-button--color:hover {
	color: #FFFFFF;
	text-decoration: underline;
