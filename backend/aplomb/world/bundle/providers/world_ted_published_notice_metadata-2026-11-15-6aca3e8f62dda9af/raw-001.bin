<script type="module">
	const warningKey = 'due-to-inactivity-your-session-will-expire';
	const expiredKey = 'due-to-inactivity-your-session-has-expired';

	try {
		await import('@liferay/language/' + Liferay.ThemeDisplay.getLanguageId() + '/frontend-js-web/all.js');

		const session = Liferay.Session;
		const warningText = Liferay.Language.get(warningKey);
		const expiredText = Liferay.Language.get(expiredKey);

		if (session && session._warningText === warningKey && warningText !== warningKey) {
			session._warningText = Liferay.Util.sub(warningText, [
				'<span class="countdown-timer">{0}</span>',
				(session.sessionLength / 60000).toString(),
				'<a class="alert-link" href="javascript:void(0);">' + Liferay.Language.get('extend') + '</a>'
			]);
		}

		if (session && session._expiredText === expiredKey && expiredText !== expiredKey) {
			session._expiredText = expiredText;
		}
	}
	catch (error) {
		// Continue with Liferay's own behaviour
	}
</script>

