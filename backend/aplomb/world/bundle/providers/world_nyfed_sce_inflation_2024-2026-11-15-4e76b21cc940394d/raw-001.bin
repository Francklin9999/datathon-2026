<script type="application/ld+json">{"@context":"https://schema.org","@type":"GovernmentOrganization","@id":"https://www.newyorkfed.org/#organization","name":"Federal Reserve Bank of New York","legalName":"Federal Reserve Bank of New York","alternateName":["New York Fed","FRBNY","NY Fed","New York Federal Reserve"],"url":"https://www.newyorkfed.org","logo":{"@type":"ImageObject","url":"https://www.newyorkfed.org/medialibrary/media/v4/images/new-york-fed-logo.svg","width":3258,"height":94},"image":{"@type":"ImageObject","url":"https://www.newyorkfed.org/medialibrary/media/images/gallery/5.jpg","caption":"Federal Reserve Bank of New York Building at 33 Liberty Street"},"description":"The New York Fed works within the Federal Reserve System to foster economic and financial stability and vitality throughout the Second District and the United States. We are one of 12 regional Reserve Banks that, along with the Board of Governors in Washington, D.C., make up our nation’s central bank.","foundingDate":"1914-11-16","slogan":"Serving the Second District and the Nation","address":{"@type":"PostalAddress","streetAddress":"33 Liberty Street","addressLocality":"New York","addressRegion":"NY","postalCode":"10045","addressCountry":"US"},"contactPoint":[{"@type":"ContactPoint","telephone":"+1-212-720-5000","contactType":"general information","areaServed":"US","availableLanguage":["en"]}],"sameAs":["https://x.com/newyorkfed","https://www.linkedin.com/company/federal-reserve-bank-of-new-york","https://www.youtube.com/user/TheNewYorkFed","https://www.facebook.com/newyorkfed","https://www.instagram.com/NewYorkFed"],"parentOrganization":{"@type":"GovernmentOrganization","name":"Federal Reserve System","url":"https://www.federalreserve.gov"},"subOrganization":[{"@type":"Organization","name":"Markets & Policy Implementation","url":"https://www.newyorkfed.org/markets"},{"@type":"Organization","name":"Economic Research","url":"https://www.newyorkfed.org/research"},{"@type":"Organization","name":"Financial Institution Supervision","url":"https://www.newyorkfed.org/financial-institution-supervision"},{"@type":"Organization","name":"Financial Services & Infrastructure","url":"https://www.newyorkfed.org/financial-services-and-infrastructure"},{"@type":"Organization","name":"Community Development & Education","url":"https://www.newyorkfed.org/outreach-and-education"},{"@type":"Organization","name":"About the New York Fed","url":"https://www.newyorkfed.org/aboutthefed"}],"member":[{"@type":"Person","name":"John C. Williams","jobTitle":"President and Chief Executive Officer","url":"https://www.newyorkfed.org/aboutthefed/orgchart/williams"}],"areaServed":{"@type":"AdministrativeArea","name":"Second District","description":"We connect with people throughout the Second District in a variety of ways, including building relationships and partnerships with leaders and organizations through community engagement, educational opportunities and more. These connections help us see the big picture of what’s happening across our District, which informs monetary policy, our research and other community development initiatives. That, in turn, helps us and the Federal Reserve System achieve our public service mission."},"knowsAbout":["Monetary Policy","Financial Markets","Banking Supervision","Financial Services","Economic Research","SOFR","Reference Rates","Open Market Operations"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Services","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Dataset","name":"Reference Rates","description":"The New York Fed produces a number of reference rates that provide insight into the dynamics of money markets, which is useful for evaluating the effectiveness of monetary policy implementation."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Economic Research","description":"Links to publications, data releases, research centers, and staff profiles"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Markets & Policy Implementation","description":"The New York Fed operates in global financial markets in a number of capacities to support the Federal Reserve’s monetary policy and financial stability objectives. It also does so in serving as fiscal agent of the United States, as may be required by the U.S. Treasury. The New York Fed also operates in global financial markets in providing banking services to about 200 central banks, governments, and international official institutions that hold U.S. dollar accounts at the New York Fed."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Financial Institution Supervision","description":"Acting on delegated authority from the Board of Governors of the Federal Reserve System, the Supervision Group of the Federal Reserve Bank of New York supervises a wide range of financial institutions that are subject to the Board’s supervision and are located in the Second Federal Reserve District. Supervision evaluates and promotes the overall safety and soundness of the supervised institutions, the stability of the financial system of the United States, and compliance with relevant laws and regulations."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Financial Services & Infrastructure","description":"The New York Fed provides financial services for financial institutions and the U.S. government and helps formulate and execute policies for oversight of U.S. and international payment systems. In addition, we foster innovation in payment systems and conduct research on topical payment issues."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Community Development","description":"Community development is one of the Federal Reserve’s core functions as the U.S. central bank, rooted in the Federal Reserve’s mandates from Congress. Our Community Development team works to understand the economic experiences of lower-income households and communities to help build a stronger economy for all Americans."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Economic Education","description":"New York Fed Economic Education creates accessible and engaging resources and programs to enhance financial and economic literacy, highlight economic experiences, and promote awareness of the Federal Reserve System to shape a better economy for all."}}]}}</script>


