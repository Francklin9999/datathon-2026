                "event": "Special Weather Statement",
                "sender": "w-nws.webmaster@noaa.gov",
                "senderName": "NWS Fairbanks AK",
                "headline": "Special Weather Statement issued November 15 at 4:40AM AKST by NWS Fairbanks AK",
                "description": "Confidence is growing in the potential for a strong coastal storm\nto take a more northerly track through the Bering Sea mid-week.\nDepending on the final track of the system, minor to moderate\ncoastal flooding impacts may be a possible for parts of the West\nCoast, with sea level rises between 3 to 7 ft possible. In\naddition to the coastal impact potential, periods of moderate to\nheavy snow and strong winds could begin as early as Tuesday night\nand last into Friday. The combination of winds and heavy snow\ncould lead to reduced visibilities at times. We will continue to\nmonitor this system closely and provide updates as additional\ninformation becomes available.",
                "instruction": null,
                "response": "Execute",
                "note": null,
                "parameters": {
                    "AWIPSidentifier": [
                        "SPSWCZ"
                    ],
                    "WMOidentifier": [
                        "WWAK82 PAFG 151340"
                    ],
                    "NWSheadline": [
                        "MID-WEEK BERING SEA LOW COULD BRING COASTAL IMPACTS, SNOW, AND WIND"
                    ],
                    "BLOCKCHANNEL": [
                        "EAS",
                        "NWEM",
                        "CMAS"
                    ],
                    "EAS-ORG": [
                        "WXR"
                    ]
                },
