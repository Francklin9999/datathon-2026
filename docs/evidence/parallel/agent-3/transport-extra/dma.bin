ad57b&quot;&#xA;}"><div><div class="filters has-filters"><div class="filter"><form class="form  " role="search" novalidate onsubmit="return false;" action="/safety-at-sea/navigational-information/ais-data"><div class="search-box"><div class="form-group search"><input type="text" id="44a9c664-fa6a-4391-9294-46328bf2cb8c" name="search" value="" placeholder="S&#xF8;g" aria-label="S&#xF8;g" class="form-control has-search-icon" />
