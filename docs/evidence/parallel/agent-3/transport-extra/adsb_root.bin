<main>

<div id="tom-marquee" class="tom-marquee" hidden title="click to dismiss">
  <div class="tom-marquee-track"><span>tom sei una lota?</span></div>
</div>
<section class="hero">
  <div>
    <p class="kicker">open flight data</p>
    <h1>adsb<span class="thin">.lol</span></h1>
  </div>
  <p class="lede"><a href="/docs/open-data/historical">5,640 GB</a> of unfiltered flight data.<br>1,389 days of daily releases.<br>a public archive of the raw feed.</p>
  
</section>

<section>
  <h2>what this is</h2>
  <p class="muted">a community-run ADS-B network. independent receivers feed one
  open dataset, published live and as a daily archive.</p>
</section>


<section class="live">
  <h2>live right now</h2>
  <dl class="stat">
    <div title="every aircraft hub is tracking right now"><dt>aircraft</dt><dd id="s-aircraft">12574</dd></div>
    <div title="aircraft currently on the ground"><dt>on the ground</dt><dd id="s-ground">1698</dd></div>
    <div title="aircraft squawking an emergency, click to see them on the map"><dt>emergencies</dt><dd><a rel="nofollow noopener" id="s-emergencylink" href="https://adsb.lol/44cc45"><span id="s-emergency">1</span></a></dd></div>
    <div title="receivers contributing to multilateration · receivers streaming raw beast data"><dt>mlat · beast</dt><dd><span id="s-mlat">6063</span> · <span id="s-beast">6443</span></dd></div>
    <div title="messages per second across the whole network"><dt>messages/s</dt><dd id="s-msgs">328372</dd></div>
    <div title="positions per second across the whole network"><dt>positions/s</dt><dd id="s-pos">135124</dd></div>
    <div title="WAN traffic of every node right now: in · out"><dt>WAN, Mbps</dt><dd><span id="s-wanin">1302</span> · <span id="s-wanout">1255</span></dd></div>
    <div title="highest and fastest aircraft right now, click to see them"><dt>high · fast</dt><dd><a rel="nofollow noopener" id="s-altlink" href="https://adsb.lol/123527"><span id="s-alt">107</span></a> kft · <a rel="nofollow noopener" id="s-speedlink" href="https://adsb.lol/781c2d"><span id="s-speed">602</span></a> kt</dd></div>
    <div title="the quickest tenth of station round trips; the median is 164 ms because busy uplinks queue"><dt>latency, ms</dt><dd id="s-lat">63</dd></div>
    <div title="how far your clock differs from the server's, measured in your browser"><dt>your clock</dt><dd id="s-clock">measuring</dd></div>
  </dl>
</section>


<section>
  <h2>see also</h2>
  <p class="muted">the <a rel="nofollow noopener" href="https://adsb.lol">live map</a>,
