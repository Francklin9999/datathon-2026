        <elements-api
            apiDescriptionUrl="/openapi.yaml"
            router="hash"
            layout="sidebar"
            style="display: block; min-height: 100vh;"></elements-api>
        <script src="/js/stoplight-elements.js"></script>
        <script>
            // Stoplight Elements collapses the sidebar endpoint groups by default
            // and its web component exposes no attribute to change that, so open
            // every collapsed group after the sidebar renders.  A collapsed group
            // header shows a "chevron-right" icon; a click on the header opens it.
            //
            // The sidebar mounts asynchronously and React can re-render it a few
            // times, so poll briefly and click the collapsed groups until none are
            // left.  Polling stops as soon as the groups are open (so it does not
            // fight a user who then collapses one) and, as a safety limit, after a
            // few seconds.
            (function () {
                var app = document.querySelector('elements-api');
                if (!app) return;
                var attempts = 0;
                var timer = setInterval(function () {
                    attempts += 1;
                    var collapsed = app.querySelectorAll(
                        '.sl-bg-canvas-100 svg[data-icon="chevron-right"]');
                    collapsed.forEach(function (svg) {
                        var header = svg.closest('.sl-bg-canvas-100');
                        if (header) header.click();
                    });
                    var ready = app.querySelectorAll('.sl-bg-canvas-100').length > 0;
                    if ((ready && collapsed.length === 0) || attempts > 40) {
                        clearInterval(timer);
                    }
                }, 250);
            })();
        </script>

