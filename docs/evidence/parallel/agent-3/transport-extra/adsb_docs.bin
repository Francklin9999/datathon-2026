<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","description":"Community ADS-B network with open flight data and a free API.","name":"adsb.lol","publisher":{"@type":"Organization","logo":"https://www.adsb.lol/static/logo.png","name":"adsb.lol","sameAs":["https://github.com/adsblol","https://mastodon.social/@adsblol","https://adsblol.zulipchat.com"],"url":"https://www.adsb.lol/"},"url":"https://www.adsb.lol/"}</script>

